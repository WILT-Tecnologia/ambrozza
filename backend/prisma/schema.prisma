generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. IDENTIDADES DA PLATAFORMA

model SuperAdmin {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  role             SuperAdminRole    @default(SUPER_ADMIN)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  decidedApprovals ApprovalRequest[]

  @@map("super_admins")
}

model Shopkeeper {
  id                 String                  @id @default(uuid())
  name               String
  email              String                  @unique
  password           String
  document           String?                 @unique
  phone              String?
  approvalStatus     ApprovalStatus          @default(PENDING)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  store              Store?
  approvalRequests   ApprovalRequest[]
  passwordResetCodes PasswordResetCode[]
  onboardingConsent  StoreOnboardingConsent?

  @@map("shopkeepers")
}

model User {
  id          String            @id @default(uuid())
  name        String
  email       String            @unique
  password    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships StoreMembership[]
  orders      Order[]

  @@map("users")
}

// 2. SISTEMA DE APROVAÇÃO (Exclusivo para Shopkeepers)

model ApprovalRequest {
  id                    String         @id @default(uuid())
  shopkeeperId          String
  status                ApprovalStatus @default(PENDING)
  reason                String?
  decidedBySuperAdminId String?
  decidedAt             DateTime?
  createdAt             DateTime       @default(now())

  shopkeeper          Shopkeeper  @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  decidedBySuperAdmin SuperAdmin? @relation(fields: [decidedBySuperAdminId], references: [id])

  @@map("approval_requests")
}

// 3. LOJAS E MEMBROS

model Store {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String

  cep           String
  state         String
  city          String
  street        String
  number        String
  neighborhood  String
  complement    String?

  allowDelivery Boolean  @default(true)
  allowPickup   Boolean  @default(false)

  colorPalette  String

  shopkeeperId  String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shopkeeper    Shopkeeper         @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  memberships   StoreMembership[]
  orders        Order[]

  @@map("stores")
}

model StoreOnboardingConsent {
  id              String     @id @default(uuid())
  shopkeeperId    String     @unique
  termsAccepted   Boolean
  privacyAccepted Boolean
  acceptedAt      DateTime   @default(now())
  shopkeeper      Shopkeeper @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)

  @@map("store_onboarding_consents")
}

model StoreMembership {
  id        String          @id @default(uuid())
  userId    String
  storeId   String
  role      StoreMemberRole @default(CUSTOMER)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("store_memberships")
}

// 4. PEDIDOS (Contexto de Compras)

model Order {
  id        String      @id @default(uuid())
  userId    String
  storeId   String
  status    OrderStatus @default(PENDING)
  total     Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model PasswordResetCode {
  id           String    @id @default(uuid())
  shopkeeperId String
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  shopkeeper Shopkeeper @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)

  @@index([shopkeeperId])
  @@map("password_reset_codes")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SuperAdminRole {
  SUPER_ADMIN
}

enum StoreMemberRole {
  CUSTOMER
  STAFF
  MANAGER
  OWNER
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  DELIVERED
}
